# =====================================================================
#  Required
# =====================================================================
# OpenAI API key. Used for both chat and embeddings. Without this set,
# validateEnv() in lib/env.ts will refuse to start.
OPENAI_API_KEY=

# =====================================================================
#  Models
# =====================================================================
# Chat model. Add to lib/pricing.ts LLM_COST_TABLE if you pick something
# outside the included list - otherwise cache savings will report $0.
LLM_MODEL=gpt-4o-mini

# Embedding model + dimension. EMBED_DIM must match the model - see
# EMBED_MODEL_DIMS in lib/pricing.ts. validateEnv() rejects mismatched
# pairs at startup so the index never gets built with the wrong shape.
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# =====================================================================
#  Valkey connection
# =====================================================================
# Local development (plaintext, loopback):
#   VALKEY_URL=redis://localhost:6399
#
# Production (TLS to a public EC2 endpoint):
#   VALKEY_URL=rediss://<user>:<password>@valkey.example.com:6379
#   - rediss:// (double s) enables TLS.
#   - <user> can be `default` if you only set requirepass, or a scoped
#     ACL user (recommended). See deploy notes below.
#   - <password> must be URL-encoded if it contains @ : / ? # etc.
VALKEY_URL=redis://localhost:6399

# Accept self-signed certs. Leave unset (or true) in production.
# Only set to "false" while testing against a self-signed dev cert.
# VALKEY_TLS_REJECT_UNAUTHORIZED=true

# Connection tuning (optional; defaults shown).
# VALKEY_CONNECT_TIMEOUT_MS=10000
# VALKEY_MAX_RETRIES_PER_REQUEST=3

# =====================================================================
#  Rate limiting + budget (server-enforced via atomic Lua)
# =====================================================================
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_PER_DAY=100
DAILY_BUDGET_USD=10

# =====================================================================
#  Caching
# =====================================================================
# Cosine DISTANCE threshold for semantic-cache hits. Lower is stricter.
SEMANTIC_THRESHOLD=0.08
SEMANTIC_TTL_SECONDS=604800
TOOL_TTL_SECONDS=86400
LLM_TTL_SECONDS=86400

# =====================================================================
#  Privacy / safety
# =====================================================================
# HMAC salt for log-IP hashing. Set to a long random string in production
# so IPs aren't correlatable across deploys. Optional - falls back to a
# per-process seed.
# LOG_IP_SALT=change-me

# Enable OpenAI Moderation pre-check on incoming queries. Adds ~50ms.
# MODERATION_ENABLED=true

# =====================================================================
#  Diagnostics
# =====================================================================
# When true, every semantic-cache MISS logs the nearest-neighbour distance,
# the configured threshold, and the confidence band. Useful for tuning
# SEMANTIC_THRESHOLD or debugging "why didn't this hit" questions.
# SEMANTIC_DEBUG=true

# =====================================================================
#  Logging
# =====================================================================
LOG_STREAM_KEY=playground:logs
LOG_STREAM_MAXLEN=10000

# =====================================================================
#  PostHog telemetry (opt-in)
# =====================================================================
# When BETTERDB_POSTHOG_API_KEY is set, every chat turn emits a
# `chat_turn` event to PostHog containing:
#   - the raw user prompt
#   - the raw client IP
#   - cache hit/miss + similarity + dollars saved
#   - tool hits + per-tool latency
#   - token counts, cost, model, total latency
# This is the canonical store for prompt-level analytics - see README's
# "Privacy" section before enabling on a production deployment.
#
# Same env-var names the rest of the @betterdb/* packages use, so a
# single PostHog project can receive events from every BetterDB surface.
# BETTERDB_POSTHOG_API_KEY=
# BETTERDB_POSTHOG_HOST=https://eu.i.posthog.com

# Hard kill-switch. Accepts: false / 0 / no / off (case-insensitive).
# Disables PostHog regardless of any key being set.
# BETTERDB_TELEMETRY=true

# =====================================================================
#  Crawler politeness (ingest scripts only)
# =====================================================================
# Override the User-Agent sent by the ingest scripts. Default identifies
# the project + a contact email. Replace with your own when self-hosting.
# SCRAPE_USER_AGENT=

# =====================================================================
#  Deploy notes
# =====================================================================
# Vercel:
#   Add every variable above under Project Settings → Environment
#   Variables (Production + Preview). VALKEY_URL must use rediss://
#   and point at your EC2 endpoint over the public internet.
#
# EC2 valkey.conf (TLS + ACL):
#   port 0
#   tls-port 6379
#   tls-cert-file /etc/letsencrypt/live/valkey.example.com/fullchain.pem
#   tls-key-file  /etc/letsencrypt/live/valkey.example.com/privkey.pem
#   tls-ca-cert-file /etc/letsencrypt/live/valkey.example.com/chain.pem
#   tls-auth-clients no
#   user default off
#   user vercel on >LONG_PASSWORD ~* +@all -@dangerous
#
# EC2 security group inbound:
#   TCP 6379 from 0.0.0.0/0  (TLS + ACL is the security boundary)
#   TCP 22   from your IP
#
# Run `pnpm build:index` from EC2 (or your laptop), NOT from a Vercel
# function - embedding 3k+ docs would blow past the 60s function limit.
